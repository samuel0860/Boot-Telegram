# =====================================================================
#  CONFIGURAÇÃO DO SISTEMA — modelo do arquivo .env
#
#  1. Copie:      cp .env.example .env
#  2. Gere as chaves marcadas com [GERAR] usando:  openssl rand -hex 32
#  3. Preencha o resto e suba:  docker compose up -d --build
#
#  O arquivo .env tem senhas e tokens: NUNCA envie para o Git/GitHub.
#  Itens marcados [OBRIGATÓRIO] precisam ser preenchidos para o sistema subir.
#  As credenciais do Mercado Livre e o WhatsApp são configurados pelo PAINEL.
# =====================================================================

# ---------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------
# development (testes) | production (servidor no ar, exige HTTPS)
APP_ENV=development
LOG_LEVEL=INFO
# [OBRIGATÓRIO][GERAR] Assina a sessão do painel e criptografa segredos salvos no banco.
# Atenção: se trocar depois, será preciso cadastrar de novo a Secret Key do Mercado Livre.
SECRET_KEY=troque-por-64-caracteres-aleatorios-gerados-com-openssl-rand-hex-32
# Endereço público do sistema (com https em produção). Usado no webhook do Mercado Pago.
PUBLIC_BASE_URL=http://localhost:8000
# Seu domínio (usado pelo proxy HTTPS automático: docker compose --profile proxy up -d)
DOMAIN=seudominio.com.br
# Fuso horário usado nos horários do painel, do bot e do backup
DISPLAY_TIMEZONE=America/Sao_Paulo

# ---------------------------------------------------------------------
# Banco de dados (PostgreSQL no Docker)
# ---------------------------------------------------------------------
POSTGRES_DB=telegram_vendas
POSTGRES_USER=telegram
# [OBRIGATÓRIO][GERAR] Use só letras e números (openssl rand -hex 24).
POSTGRES_PASSWORD=troque_esta_senha
# Porta do banco no servidor. 127.0.0.1 = só a própria máquina acessa (recomendado).
POSTGRES_PORT=5432
POSTGRES_BIND_ADDRESS=127.0.0.1
# Conexão usada quando o backend/bot rodam FORA do Docker. Use a MESMA senha de cima.
# (Dentro do Docker o endereço é ajustado automaticamente para o serviço "postgres".)
DATABASE_URL=postgresql+psycopg://telegram:troque_esta_senha@localhost:5432/telegram_vendas
SQL_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ---------------------------------------------------------------------
# Backup automático (serviço "backup")
# ---------------------------------------------------------------------
# Hora do backup diário (0 a 23) e quantos dias de backups manter em ./backups
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14
# Usuário/grupo dono dos arquivos de backup no servidor (comando: id -u / id -g)
BACKUP_UID=1000
BACKUP_GID=1000

# ---------------------------------------------------------------------
# Painel web e página inicial
# ---------------------------------------------------------------------
BACKEND_PORT=8000
# 127.0.0.1 = só o próprio servidor | IP da rede = acesso pela rede interna | use proxy HTTPS na internet
BACKEND_BIND_ADDRESS=127.0.0.1
# true quando estiver em HTTPS (padrão automático: true em production)
SESSION_COOKIE_SECURE=
# Tempo de login no painel (segundos) e bloqueio por senha errada
SESSION_MAX_AGE_SECONDS=28800
ADMIN_MAX_FAILED_LOGINS=5
ADMIN_LOCKOUT_MINUTES=15

# ---------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------
# [OBRIGATÓRIO] Token do bot, fornecido pelo @BotFather
TELEGRAM_BOT_TOKEN=
# Username do bot SEM @ (ex.: MinhaLojaBot). É o link do botão da página inicial.
TELEGRAM_BOT_USERNAME=
# Origem registrada no /start (ex.: tiktok) — aparece em Usuários no painel
TELEGRAM_START_PARAM=tiktok
# Contato mostrado no botão "Suporte"
SUPPORT_CONTACT=@seu_suporte
# Opcional: IDs de administradores (separados por vírgula). O jeito mais fácil é
# vincular pelo painel: Minha conta → Conectar meu Telegram (/vincular CÓDIGO).
ADMIN_TELEGRAM_IDS=
# Validade (horas) dos convites individuais para grupos/canais pagos
INVITE_LINK_TTL_HOURS=24
# Dias antes do vencimento para lembrar o assinante (0 = não lembrar)
EXPIRY_REMINDER_DAYS=3
DELIVERY_MAX_ATTEMPTS=5

# ---------------------------------------------------------------------
# Pagamentos PIX (Mercado Pago) — vendas do funil
# ---------------------------------------------------------------------
# Access Token em: https://www.mercadopago.com.br/developers/panel/app
MP_ACCESS_TOKEN=
# Assinatura secreta do webhook (sua aplicação → Webhooks). Obrigatório em production.
MP_WEBHOOK_SECRET=
MP_API_BASE=https://api.mercadopago.com
# Tempo para pagar o PIX (minutos)
PIX_EXPIRATION_MINUTES=30
# O Mercado Pago exige e-mail do pagador; o sistema usa tg<ID>@<este domínio>
PAYER_EMAIL_DOMAIN=seudominio.com.br
CURRENCY=BRL
# Anti-abuso: máximo de PIX que um usuário pode gerar em 10 minutos
MAX_ORDERS_PER_10MIN=5

# ---------------------------------------------------------------------
# WhatsApp (serviço "whatsapp" — Evolution API)
# ---------------------------------------------------------------------
# [OBRIGATÓRIO][GERAR] Chave interna entre o sistema e o serviço do WhatsApp
EVOLUTION_API_KEY=troque_esta_chave_do_whatsapp
# Fora do Docker use http://localhost:8080 (no Docker é ajustado automaticamente)
EVOLUTION_API_URL=http://localhost:8080
