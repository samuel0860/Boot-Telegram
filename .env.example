# =====================================================================
# Copie para .env e preencha:  cp .env.example .env
# NUNCA envie o arquivo .env para o Git.
# =====================================================================

# ---------------- Aplicação ----------------
# development | production
APP_ENV=development
LOG_LEVEL=INFO
# Chave para assinar a sessão do painel. Gere com: openssl rand -hex 32
SECRET_KEY=troque-por-uma-chave-aleatoria-com-64-caracteres-hexadecimais-aaaa
# URL pública do backend (HTTPS em produção). Usada para o webhook do Mercado Pago.
PUBLIC_BASE_URL=http://localhost:8000
# Domínio do proxy HTTPS (Caddy) — usado com: docker compose --profile proxy up -d
DOMAIN=seudominio.com.br
DISPLAY_TIMEZONE=America/Sao_Paulo

# ---------------- PostgreSQL (container) ----------------
POSTGRES_DB=telegram_vendas
POSTGRES_USER=telegram
# Senha forte, sem caracteres especiais de URL (@ : / ? #). Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=troque_esta_senha
# Porta publicada no host. 127.0.0.1 = acessível apenas nesta máquina (recomendado).
POSTGRES_PORT=5432
POSTGRES_BIND_ADDRESS=127.0.0.1

# Conexão usada quando o backend/bot rodam FORA do Docker (localhost + porta publicada).
# Dentro do Docker, o docker-compose.yml substitui automaticamente o host por "postgres".
DATABASE_URL=postgresql+psycopg://telegram:troque_esta_senha@localhost:5432/telegram_vendas
SQL_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ---------------- Backend web ----------------
BACKEND_PORT=8000
BACKEND_BIND_ADDRESS=127.0.0.1

# ---------------- Telegram ----------------
# Token fornecido pelo @BotFather
TELEGRAM_BOT_TOKEN=
# Username do bot sem @ (ex.: MinhaLojaBot) — usado no botão da página inicial
TELEGRAM_BOT_USERNAME=
# Parâmetro enviado no /start para identificar a origem (ex.: tiktok)
TELEGRAM_START_PARAM=tiktok
# Contato exibido no botão Suporte (ex.: @meusuporte)
SUPPORT_CONTACT=@seu_suporte
# Seu ID numérico do Telegram (separe vários por vírgula). Libera /chatid e captura de file_id.
ADMIN_TELEGRAM_IDS=
# Validade (horas) dos convites individuais para grupos/canais
INVITE_LINK_TTL_HOURS=24
# Dias antes do vencimento para lembrar o assinante (0 = desativado)
EXPIRY_REMINDER_DAYS=3
DELIVERY_MAX_ATTEMPTS=5

# ---------------- Mercado Pago / PIX ----------------
# Credenciais em: https://www.mercadopago.com.br/developers/panel/app
MP_ACCESS_TOKEN=
# Assinatura secreta do webhook (Painel > Sua aplicação > Webhooks)
MP_WEBHOOK_SECRET=
MP_API_BASE=https://api.mercadopago.com
PIX_EXPIRATION_MINUTES=30
# O Mercado Pago exige um e-mail do pagador; usamos tg<ID>@<domínio>
PAYER_EMAIL_DOMAIN=seudominio.com.br
CURRENCY=BRL
MAX_ORDERS_PER_10MIN=5

# ---------------- Painel administrativo ----------------
# true em produção (HTTPS). Padrão: true quando APP_ENV=production
SESSION_COOKIE_SECURE=
SESSION_MAX_AGE_SECONDS=28800
ADMIN_MAX_FAILED_LOGINS=5
ADMIN_LOCKOUT_MINUTES=15
